#ifndef PG_CONFIG_H
#define PG_CONFIG_H

/* ---- версия ---- */
#define PG_VERSION "@PG_VERSION@"
#define PG_MAJORVERSION "@PG_MAJORVERSION@"
#define PG_MAJORVERSION_NUM @PG_MAJORVERSION_NUM@
#define PG_MINORVERSION_NUM @PG_MINORVERSION_NUM@
#define PG_VERSION_NUM @PG_VERSION_NUM@
#define PG_VERSION_STR "PostgreSQL @PG_VERSION@ (UnrealCore build)"

/* ---- заголовки ---- */
#cmakedefine HAVE_CRYPT_H 1
#cmakedefine HAVE_DLFCN_H 1
#cmakedefine HAVE_IFADDRS_H 1
#cmakedefine HAVE_LANGINFO_H 1
#cmakedefine HAVE_NETINET_TCP_H 1
#cmakedefine HAVE_POLL_H 1
#cmakedefine HAVE_PWD_H 1
#cmakedefine HAVE_STRINGS_H 1
#cmakedefine HAVE_SYS_EPOLL_H 1
#cmakedefine HAVE_SYS_EVENT_H 1
#cmakedefine HAVE_SYS_PERSONALITY_H 1
#cmakedefine HAVE_SYS_PRCTL_H 1
#cmakedefine HAVE_SYS_RESOURCE_H 1
#cmakedefine HAVE_SYS_SELECT_H 1
#cmakedefine HAVE_SYS_SIGNALFD_H 1
#cmakedefine HAVE_SYS_UCRED_H 1
#cmakedefine HAVE_SYS_UN_H 1
#cmakedefine HAVE_TERMIOS_H 1
#cmakedefine HAVE_UCRED_H 1
#cmakedefine HAVE_UNISTD_H 1

/* ---- функции ---- */
#cmakedefine HAVE_CLOCK_GETTIME 1
#cmakedefine HAVE_EXPLICIT_BZERO 1
#cmakedefine HAVE_GETADDRINFO 1
#cmakedefine HAVE_GETIFADDRS 1
#cmakedefine HAVE_GETOPT 1
#cmakedefine HAVE_GETOPT_LONG 1
#cmakedefine HAVE_GETPEEREID 1
#cmakedefine HAVE_GETPEERUCRED 1
#cmakedefine HAVE_INET_ATON 1
#cmakedefine HAVE_INET_PTON 1
#cmakedefine HAVE_MEMSET_S 1
#cmakedefine HAVE_MKDTEMP 1
#cmakedefine HAVE_POLL 1
#cmakedefine HAVE_POSIX_FALLOCATE 1
#cmakedefine HAVE_PPOLL 1
#cmakedefine HAVE_PTHREAD_BARRIER_WAIT 1
#cmakedefine HAVE_PTHREAD_IS_THREADED_NP 1
#cmakedefine HAVE_READLINK 1
#cmakedefine HAVE_SETSID 1
#cmakedefine HAVE_STRCHRNUL 1
#cmakedefine HAVE_STRERROR_R 1
#cmakedefine HAVE_STRLCAT 1
#cmakedefine HAVE_STRLCPY 1
#cmakedefine HAVE_STRNLEN 1
#cmakedefine HAVE_STRSIGNAL 1
#cmakedefine HAVE_SYNC_FILE_RANGE 1
#cmakedefine HAVE_UNSETENV 1
#cmakedefine HAVE_USELOCALE 1

/* ---- типы и размеры ---- */
#cmakedefine HAVE_INT64 1
#cmakedefine HAVE_LOCALE_T 1
#cmakedefine HAVE_STRUCT_ADDRINFO 1
#cmakedefine HAVE_STRUCT_OPTION 1
#cmakedefine HAVE_STRUCT_SOCKADDR_STORAGE 1
#cmakedefine HAVE_STRUCT_SOCKADDR_STORAGE_SS_FAMILY 1
#cmakedefine HAVE_STRUCT_SOCKADDR_UN 1
#cmakedefine HAVE_UNION_SEMUN 1
#define SIZEOF_BOOL @SIZEOF_BOOL@
#define SIZEOF_LONG @SIZEOF_LONG@
#define SIZEOF_OFF_T @SIZEOF_OFF_T@
#define SIZEOF_SIZE_T @SIZEOF_SIZE_T@
#define SIZEOF_VOID_P @SIZEOF_VOID_P@
#define ALIGNOF_DOUBLE 8
#define ALIGNOF_INT 4
#define ALIGNOF_LONG @ALIGNOF_LONG@
#define ALIGNOF_SHORT 2
#define ALIGNOF_PG_INT128_TYPE 16
#define MAXIMUM_ALIGNOF 8
#cmakedefine PG_INT128_TYPE @PG_INT128_TYPE@
#define PG_KRB_SRVNAM "postgres"
#cmakedefine WORDS_BIGENDIAN 1

/* ---- атрибуты компилятора ---- */
#cmakedefine HAVE_BUILTIN_BSWAP16 1
#cmakedefine HAVE_BUILTIN_BSWAP32 1
#cmakedefine HAVE_BUILTIN_BSWAP64 1
#cmakedefine HAVE_BUILTIN_CLZ 1
#cmakedefine HAVE_BUILTIN_CTZ 1
#cmakedefine HAVE_BUILTIN_POPCOUNT 1
#cmakedefine HAVE_BUILTIN_UNREACHABLE 1
#cmakedefine HAVE_COMPUTED_GOTO 1
#cmakedefine HAVE_FUNCNAME__FUNC 1
#cmakedefine HAVE_FUNCNAME__FUNCTION 1
#cmakedefine HAVE_VISIBILITY_ATTRIBUTE 1
#cmakedefine HAVE__STATIC_ASSERT 1
#cmakedefine PG_PRINTF_ATTRIBUTE @PG_PRINTF_ATTRIBUTE@

/* ---- сборка libpq: без SSL/GSS/LDAP/NLS/ICU ---- */
/* #undef USE_OPENSSL */
/* #undef USE_SSL */
/* #undef ENABLE_GSS */
/* #undef USE_LDAP */
/* #undef ENABLE_NLS */
/* #undef USE_ICU */
#define USE_UNNAMED_POSIX_SEMAPHORES 1
#define DEF_PGPORT 5432
#define DEF_PGPORT_STR "5432"
#define PG_USE_STDBOOL 1
#define BLCKSZ 8192
#define XLOG_BLCKSZ 8192
#define RELSEG_SIZE 131072
#define NAMEDATALEN 64
#define ALIGNOF_MAX 8
#define MEMSET_LOOP_LIMIT 1024
#define PG_CACHE_LINE_SIZE 128
#define pg_restrict __restrict

/* ---- Windows ---- */
#ifdef _MSC_VER
#define HAVE_DECL_STRLCAT 0
#define HAVE_DECL_STRLCPY 0
#define HAVE_DECL_STRNLEN 1
#define inline __inline
#define pg_attribute_printf(f, a)

#define SIZEOF_LONG 4
#define SIZEOF_LONG_LONG 8
#define SIZEOF_INT 4
#define SIZEOF_OFF_T 4
#define SIZEOF_SIZE_T 8
#define SIZEOF_VOID_P 8
#define ALIGNOF_SHORT 2
#define ALIGNOF_INT 4
#define ALIGNOF_LONG 4
#define ALIGNOF_LONG_LONG_INT 8
#define ALIGNOF_DOUBLE 8
#define MAXIMUM_ALIGNOF 8
#endif

#endif /* PG_CONFIG_H */
